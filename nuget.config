<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repository-scoped NuGet configuration.

    <clear /> discards any package sources inherited from machine/user-level
    configs (e.g. a private ABB "EkipFeed" configured on the self-hosted CI
    runner). Without this, `dotnet restore` on the runner tries that private
    feed and fails with NU1301: 401 (Unauthorized).

    All dependencies of this repo (including Diginsight.Core / Diginsight.Diagnostics
    / Diginsight.Components*) are published to public nuget.org, so nuget.org is
    the only source needed. This keeps restore deterministic and credential-free
    both locally and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
