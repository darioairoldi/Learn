@* Recursive renderer for the navigation tree parsed from navigation.json. *@

<ul class="nav-list">
    @foreach (NavNode node in Nodes)
    {
        @if (node.IsSeparator)
        {
            <li class="nav-sep">
                <hr />
            </li>
        }
        else if (node.Section is not null)
        {
            <li class="nav-section">
                <details open="@ContainsActive(node)">
                    <summary>
                        @if (!string.IsNullOrEmpty(node.Icon))
                        {
                            <i class="bi bi-@node.Icon"></i>
                        }
                        <span>@node.Section</span>
                    </summary>
                    @if (node.Contents is { Count: > 0 })
                    {
                        <NavTree Nodes="node.Contents" />
                    }
                </details>
            </li>
        }
        else if (node.Href is not null)
        {
            <li>
                <NavLink class="nav-link" href="@NavNode.ToRoute(node.Href)" Match="NavLinkMatch.All">
                    @if (!string.IsNullOrEmpty(node.Icon))
                    {
                        <i class="bi bi-@node.Icon"></i>
                    }
                    <span>@node.Text</span>
                </NavLink>
            </li>
        }
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavNode> Nodes { get; set; } = Array.Empty<NavNode>();

    [CascadingParameter(Name = "CurrentRoute")] public string? CurrentRoute { get; set; }

    private bool ContainsActive(NavNode node)
    {
        if (node.Href is not null && Matches(node.Href))
        {
            return true;
        }

        if (node.Contents is not null)
        {
            foreach (NavNode child in node.Contents)
            {
                if (ContainsActive(child))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private bool Matches(string href) =>
        !string.IsNullOrEmpty(CurrentRoute) &&
        string.Equals(NavNode.ToRoute(href), CurrentRoute, StringComparison.OrdinalIgnoreCase);
}
