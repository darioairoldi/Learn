@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject ThemeState Theme

<div class="page theme-@Theme.ThemeId">
    <header class="topbar">
        <button class="nav-toggle" title="Toggle menu" @onclick="() => _navOpen = !_navOpen">☰</button>
        <a class="brand" href=""><i class="bi bi-lightbulb-fill"></i> <span>Learning Hub</span></a>
        <TopMenu Placement="TopMenu.Group.Left" />
        <span class="topbar-spacer"></span>
        <TopMenu Placement="TopMenu.Group.Right" />
        <AboutMenu />
        <button class="icon-btn" title="Search" @onclick="() => _searchOpen = true">
            <i class="bi bi-search"></i>
        </button>
        <button class="icon-btn" title="Notifications" @onclick="() => _notifyOpen = !_notifyOpen">
            <i class="bi bi-bell"></i>
        </button>
        <button class="theme-btn" title="Toggle light/dark" @onclick="() => Theme.Toggle()">
            @(Theme.Dark ? "☀️" : "🌙")
        </button>
    </header>

    <SearchOverlay Open="_searchOpen" OnClose="() => _searchOpen = false" />
    <NotificationPanel Open="_notifyOpen" OnClose="() => _notifyOpen = false" />

    <div class="body">
        <nav class="sidebar @(_navOpen ? null : "collapsed")">
            <NavMenu />
        </nav>
        <div class="sidebar-resizer" title="Drag to resize · double-click to reset"></div>
        <main class="content">
            @Body
        </main>
        <TocPane />
    </div>

    <footer class="bottombar">
        <span>Learning Hub · rendered on demand from Markdown — no build step.</span>
        <span class="bottombar-right">Learn.Web · Blazor WASM (prerendered)</span>
    </footer>
</div>

@code {
    private bool _navOpen = true;
    private bool _searchOpen;
    private bool _notifyOpen;

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    private async void OnThemeChanged()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "lh-theme", Theme.ThemeId);
        }
        catch
        {
            /* JS not available during prerender */
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string? saved = await JS.InvokeAsync<string?>("localStorage.getItem", "lh-theme");
            Theme.SetTheme(saved);
            await JS.InvokeVoidAsync("appUi.initResizer");
            await JS.InvokeVoidAsync("appUi.initTocResizer");
        }
    }

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
