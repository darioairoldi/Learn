@inject NavigationService Nav
@inject INavProvider NavProvider

@if (_nodes is not null)
{
    <nav class="topmenu">
        @foreach (NavNode node in DisplayNodes())
        {
            @if (node.IsSeparator)
            {
                <span class="topmenu-sep"></span>
            }
            else if (node.Href is not null)
            {
                <a class="topmenu-link" href="@NavNode.ToRoute(node.Href)">
                    @if (!string.IsNullOrEmpty(IconFor(node)))
                    {
                        <i class="bi bi-@IconFor(node)"></i>
                    }
                    <span>@ShortFor(node)</span>
                </a>
            }
            else if (node.Section is not null)
            {
                <div class="topmenu-item">
                    <button class="topmenu-btn" type="button">
                        @if (!string.IsNullOrEmpty(IconFor(node)))
                        {
                            <i class="bi bi-@IconFor(node)"></i>
                        }
                        <span>@ShortFor(node)</span>
                        <span class="caret">▾</span>
                    </button>
                    @if (node.Contents is { Count: > 0 })
                    {
                        <div class="topmenu-dropdown">
                            <TopMenuDropdown Nodes="node.Contents" />
                        </div>
                    }
                </div>
            }
        }
    </nav>
}

@code {
    public enum Group { Left, Right }

    [Parameter] public Group Placement { get; set; } = Group.Left;

    private IReadOnlyList<NavNode>? _nodes;

    // Top-level folder → icon + short label, taken from the live folder metadata (metadata.yml) so the
    // top bar always matches the sidebar. Keyed by the top-level folder prefix (e.g. "02.00-events").
    private IReadOnlyDictionary<string, string?> _iconByPrefix =
        new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyDictionary<string, string?> _shortByPrefix =
        new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _nodes = await Nav.GetAsync();

        IReadOnlyList<NavChild> root = await NavProvider.GetChildrenAsync(string.Empty);
        var byPrefix = root
            .Where(r => !string.IsNullOrEmpty(r.Prefix))
            .GroupBy(r => r.Prefix!, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
        _iconByPrefix = byPrefix.ToDictionary(r => r.Prefix!, r => r.Icon, StringComparer.OrdinalIgnoreCase);
        _shortByPrefix = byPrefix.ToDictionary(r => r.Prefix!, r => r.Short, StringComparer.OrdinalIgnoreCase);
    }

    // Prefer the folder-metadata icon (matched by folder prefix); fall back to navigation.json's own.
    private string? IconFor(NavNode n)
    {
        string? prefix = FolderPrefix(n);
        return prefix is not null && _iconByPrefix.TryGetValue(prefix, out string? icon) && !string.IsNullOrEmpty(icon)
            ? icon
            : n.Icon;
    }

    private static string? FolderPrefix(NavNode n)
    {
        string? href = FirstHref(n);
        if (string.IsNullOrEmpty(href))
        {
            return null;
        }

        href = href.Replace('\\', '/').TrimStart('/');
        int slash = href.IndexOf('/');
        return slash > 0 ? href[..slash] : null;
    }

    private static string? FirstHref(NavNode n)
    {
        if (!string.IsNullOrEmpty(n.Href))
        {
            return n.Href;
        }

        if (n.Contents is not null)
        {
            foreach (NavNode child in n.Contents)
            {
                string? href = FirstHref(child);
                if (href is not null)
                {
                    return href;
                }
            }
        }

        return null;
    }

    // Sections that live on the right side of the bar, in display order (matches the legacy navbar).
    private static readonly string[] RightOrder =
    {
        "Issues & Solutions", "Ideas & Projects", "Culture & Travel", "Other Technologies",
    };

    private static string Key(NavNode n) => n.Section ?? n.Text ?? string.Empty;

    private static bool IsRight(NavNode n) => Array.IndexOf(RightOrder, Key(n)) >= 0;

    private IEnumerable<NavNode> DisplayNodes()
    {
        if (_nodes is null)
        {
            return Enumerable.Empty<NavNode>();
        }

        IEnumerable<NavNode> items = _nodes.Where(n => !n.IsSeparator);
        return Placement == Group.Right
            ? items.Where(IsRight).OrderBy(n => Array.IndexOf(RightOrder, Key(n)))
            : items.Where(n => !IsRight(n));
    }

    // Compact top-level label from folder metadata (metadata.yml `short:`); falls back to the full name.
    private string ShortFor(NavNode n)
    {
        string? prefix = FolderPrefix(n);
        return prefix is not null && _shortByPrefix.TryGetValue(prefix, out string? s) && !string.IsNullOrEmpty(s)
            ? s
            : (n.Section ?? n.Text ?? string.Empty);
    }
}
