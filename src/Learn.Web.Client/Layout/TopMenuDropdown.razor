@* Recursive dropdown body for the top-level menus. *@

<ul class="dropdown-list">
    @foreach (NavNode node in Nodes)
    {
        @if (node.IsSeparator)
        {
            <li class="dropdown-sep">
                <hr />
            </li>
        }
        else if (node.Contents is { Count: > 0 })
        {
            @* A group: render its header (linked when the folder itself has a page) then recurse.
               Checked BEFORE Href so folders that also carry a readme link still show their children. *@
            <li class="dropdown-group">
                @if (node.Href is not null)
                {
                    <a class="dropdown-header dropdown-link" href="@NavNode.ToRoute(node.Href)">@(node.Section ?? node.Text)</a>
                }
                else
                {
                    <span class="dropdown-header">@(node.Section ?? node.Text)</span>
                }
                <TopMenuDropdown Nodes="node.Contents" />
            </li>
        }
        else if (node.Href is not null)
        {
            <li>
                <a class="dropdown-link" href="@NavNode.ToRoute(node.Href)">@(node.Text ?? node.Section)</a>
            </li>
        }
        else if (node.Section is not null)
        {
            <li class="dropdown-group">
                <span class="dropdown-header">@node.Section</span>
            </li>
        }
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavNode> Nodes { get; set; } = Array.Empty<NavNode>();
}
