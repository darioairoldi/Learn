<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Learn.Web</RootNamespace>
    <AssemblyName>Learn.Web</AssemblyName>
    <UserSecretsId>learn-web-blob-proxy</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server content source over blob storage (production). -->
    <PackageReference Include="Azure.Identity" Version="1.*" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
    <!-- Host the WebAssembly client with prerendering. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.*" />
    <!-- File logging to the shared Diginsight log folder (matches the sample apps). -->
    <PackageReference Include="log4net" Version="3.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Learn.Web.Client\Learn.Web.Client.csproj" />
    <ProjectReference Include="..\Learn.Web.Shared\Learn.Web.Shared.csproj" />
  </ItemGroup>

</Project>
