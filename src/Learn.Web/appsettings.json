{
  "AllowedHosts": "*",
  "AzureKeyVault": {
    "Uri": ""
  },
  "Content": {
    "Blob": {
      // Environment-specific — leave blank in the base file. Provide the real AccountUri via
      // appsettings.{Environment}.json (e.g. appsettings.Testmc.json), Key Vault, or an App Service setting.
      "AccountUri": "",
      "ContainerName": "learn"
    },
    "InvalidateApiKey": "",
    "NotFoundPath": "404.html",
    "Source": "Blob"
  },
  "Diginsight": {
    "Activities": {
      "ActivitySources": {
        "Diginsight.*": true,
        "Experimental.*": false,
        "Learn.Web": true,
        "Microsoft.AspNetCore": true,
        "System.Net.Http": true
      },
      "LogBehavior": "Show",
      "LoggedActivityNames": {
        "Microsoft.AspNetCore.Hosting.HttpRequestIn": "Hide",
        "System.Net.Http|System.Net.Http.HttpRequestOut": "Hide"
      },
      "LogLevel": "Debug",
      "MeterName": "Learn.Web",
      "MetricSpecificSpanMeasuredActivityNames": [
        {
          "ActivityNames": {},
          "MetricName": "diginsight.span_duration"
        },
        {
          "ActivityNames": {},
          "MetricName": "diginsight.query_cost"
        }
      ],
      "MetricSpecificTags": [
        {
          "MetricName": "diginsight.span_duration",
          "MetricTags": []
        },
        {
          "MetricName": "diginsight.query_cost",
          "MetricTags": []
        }
      ],
      "MetricTags": [
        "category_name",
        "device_type",
        "plant_company",
        "plant_id",
        "plant_name",
        "plant_type",
        "user_company",
        "widget_template"
      ],
      "RecordSpanDuration": true,
      "SpanMeasuredActivityNames": {
        "*Controller*": true,
        "*CosmosDbObservableExtensions*": true,
        "*ObservableFeedIterator*": true,
        "ObservableTransactionalBatch": true
      }
    },
    "Components": {
      // IParallelService tiers (bounded ParallelOptions.MaxDegreeOfParallelism):
      // Low = heavy/expensive/fragile per-item work (protect scarce downstream capacity),
      // Medium = ordinary, non-heavy I/O (the everyday default),
      // High = cheap/fast, low-footprint work against a robust downstream.
      "LowConcurrency": 2,
      "MediumConcurrency": 8,
      "HighConcurrency": 16
    },
    "SmartCache": {
      "AbsoluteExpiration": "31.00:00:00",
      "Enabled": false,
      "MaxAge": "7.00:00:00",
      "Redis": {
        // Set "Configuration" (e.g. "localhost:6379") to enable the Redis passive backing store.
        "Configuration": "",
        "KeyPrefix": "learn-content:"
      },
      "ServiceBus": {
        // "ConnectionString" from Key Vault; with a TopicName it enables the Service Bus companion.
        "TopicName": "smartcache-learnweb"
      },
      "SlidingExpiration": "7.00:00:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Diginsight.SmartCache.Externalization.ServiceBus": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Observability": {
    "ConsoleEnabled": true,
    "DebugEnabled": false,
    "Log4NetEnabled": true
  },
  "OpenTelemetry": {
    "ActivitySources": [
      "Diginsight.*",
      "Learn.Web",
      "Microsoft.AspNetCore"
    ],
    "AzureMonitorConnectionString": "",
    "EnableMetrics": true,
    "EnableTraces": true,
    "ExcludedHttpHosts": [
      ".applicationinsights.azure.com",
      ".monitor.azure.com"
    ],
    "Meters": [
      "Learn.Web"
    ]
  }
}