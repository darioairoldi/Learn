{
    "AzureKeyVault": {
        "Uri": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Diginsight.SmartCache.Externalization.ServiceBus": "Warning"
        }
    },
    "Diginsight": {
        "Activities": {
            "LogBehavior": "Show",
            "LogLevel": "Debug",
            "RecordSpanDuration": true,
            "MeterName": "Learn.Web",
            "ActivitySources": {
                "Microsoft.AspNetCore": true,
                "System.Net.Http": true,
                "Experimental.*": false,
                "Diginsight.*": true,
                "Learn.Web": true
            },
            "LoggedActivityNames": {
                "System.Net.Http|System.Net.Http.HttpRequestOut": "Hide",
                "Microsoft.AspNetCore.Hosting.HttpRequestIn": "Hide"
            },
            "SpanMeasuredActivityNames": {
                "*Controller*": true,
                "*ObservableFeedIterator*": true,
                "*CosmosDbObservableExtensions*": true,
                "ObservableTransactionalBatch": true
            },
            "MetricSpecificSpanMeasuredActivityNames": [
                {
                    "MetricName": "diginsight.span_duration",
                    "ActivityNames": {}
                },
                {
                    "MetricName": "diginsight.query_cost",
                    "ActivityNames": {}
                }
            ],
            "MetricTags": [
                "category_name",
                "widget_template",
                "plant_id",
                "plant_type",
                "plant_name",
                "plant_company",
                "device_type",
                "user_company"
            ],
            "MetricSpecificTags": [
                {
                    "MetricName": "diginsight.span_duration",
                    "MetricTags": []
                },
                {
                    "MetricName": "diginsight.query_cost",
                    "MetricTags": []
                }
            ]
        },
        "SmartCache": {
            "MaxAge": "00:05",
            // Class-aware override example (freshness per caller type):
            // "MaxAge@SmartCacheContentSource": "12:00",
            "AbsoluteExpiration": "1",
            "SlidingExpiration": "04:00",
            "ServiceBus": {
                // "ConnectionString" from Key Vault; with a TopicName it enables the Service Bus companion.
                "TopicName": "smartcache-learnweb"
            },
            "Redis": {
                // Set "Configuration" (e.g. "localhost:6379") to enable the Redis passive backing store.
                "Configuration": "",
                "KeyPrefix": "learn-content:"
            }
        }
    },
    "Observability": {
        "ConsoleEnabled": true,
        "Log4NetEnabled": true,
        "DebugEnabled": false
    },
    "OpenTelemetry": {
        "EnableTraces": true,
        "EnableMetrics": true,
        "AzureMonitorConnectionString": "",
        "ActivitySources": [
            "Microsoft.AspNetCore",
            "Diginsight.*",
            "Learn.Web"
        ],
        "Meters": [
            "Learn.Web"
        ],
        "ExcludedHttpHosts": [
            ".applicationinsights.azure.com",
            ".monitor.azure.com"
        ]
    },
    "Content": {
        "Source": "Blob",
        "NotFoundPath": "404.html",
        "InvalidateApiKey": "",
        "Blob": {
            "AccountUri": "https://digitoolstestmcstitn01.blob.core.windows.net",
            "ContainerName": "learn"
        },
        "Cache": {
            "Enabled": false,
            "MaxAgeSeconds": 3600,
            "Redis": {
                "Configuration": "",
                "KeyPrefix": "learn-content:"
            }
        }
    },
    "AllowedHosts": "*"
}