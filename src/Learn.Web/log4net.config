<?xml version="1.0" encoding="utf-8"?>
<!--
  File logging for Learn.Web. Writes to the shared Diginsight log folder so the logs sit
  next to the other apps' logs on the developer machine:
      %USERPROFILE%\LogFiles\Diginsight\Learn.Web.<yyyyMMdd>.log
  The LogDir property is set in Program.cs from the user profile path.
-->
<log4net>
  <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}\Learn.Web" />
    <staticLogFileName value="false" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value=".yyyyMMdd'.log'" />
    <preserveLogFileNameExtension value="false" />
    <maxSizeRollBackups value="30" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFile" />
  </root>

  <logger name="Learn.Web">
    <level value="DEBUG" />
  </logger>
  <logger name="Microsoft.AspNetCore">
    <level value="WARN" />
  </logger>
</log4net>
