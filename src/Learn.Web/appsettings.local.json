{
  "AzureKeyVault": {
    "Uri": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Learn": "Trace",
      "Diginsight": "Debug",
      "Diginsight.SmartCache.Externalization.ServiceBus": "Warning",
      "*.BodyLoggingHandler": "Trace"
    }
  },
  "Diginsight": {
    "Activities": {
      "LogBehavior": "Show",
      "LogLevel": "Debug",
      "RecordSpanDuration": true,
      "MeterName": "Learn.Web",
      "ActivitySources": {
        "Azure.Cosmos.Operation": true,
        "Azure.Storage.Blobs.BlobBaseClient": true,
        "Microsoft.AspNetCore": true,
        "System.Net.Http": true,
        "Experimental.*": false,
        "Diginsight.*": true,
        "Learn.Web": true
      },
      "LoggedActivityNames": {
        "System.Net.Http|System.Net.Http.HttpRequestOut": "Hide",
        "Microsoft.AspNetCore.Hosting.HttpRequestIn": "Hide"
      },
      "SpanMeasuredActivityNames": {
        "*Endpoints*": true,
        "*ObservableFeedIterator*": true,
        "*CosmosDbObservableExtensions*": true,
        "ObservableTransactionalBatch": true
      },
      "MetricSpecificSpanMeasuredActivityNames": [
        {
          "MetricName": "diginsight.span_duration",
          "ActivityNames": {
          }
        },
        {
          "MetricName": "diginsight.query_cost",
          "ActivityNames": {
          }
        }
      ],
      "MetricTags": [
        "category_name",
        "widget_template",
        "plant_id",
        "plant_type",
        "plant_name",
        "plant_company",
        "device_type",
        "user_company"
      ],
      "MetricSpecificTags": [
        {
          "MetricName": "diginsight.span_duration",
          "MetricTags": [
          ]
        },
        {
          "MetricName": "diginsight.query_cost",
          "MetricTags": [
          ]
        }
      ]
    },
    "Components": {
      // IParallelService tiers (bounded ParallelOptions.MaxDegreeOfParallelism):
      // Low = heavy/expensive/fragile per-item work (protect scarce downstream capacity),
      // Medium = ordinary, non-heavy I/O (the everyday default),
      // High = cheap/fast, low-footprint work against a robust downstream.
      "LowConcurrency": 1,
      "MediumConcurrency": 1,
      "HighConcurrency": 1
    }
  },
  "Observability": {
    "ConsoleEnabled": true,
    "Log4NetEnabled": true,
    "DebugEnabled": false
  },
  "OpenTelemetry": {
    "EnableTraces": true,
    "EnableMetrics": true,
    "AzureMonitorConnectionString": "",
    "ActivitySources": [
      "Microsoft.AspNetCore",
      "Diginsight.*",
      "Learn.Web"
    ],
    "Meters": [
      "Learn.Web"
    ],
    "ExcludedHttpHosts": [
      ".applicationinsights.azure.com",
      ".monitor.azure.com"
    ]
  },
  "AllowedHosts": "*"
}